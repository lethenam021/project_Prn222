@model Presentation.ViewModel.CouponVM
@using DataAccess.Models
@using Presentation.ViewModel
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Manage Coupons - Modernize Free</title>
    <link rel="shortcut icon" type="image/png" href="/Modernize-1.0.0/Modernize-1.0.0/src/assets/images/logos/favicon.png" />
    <link rel="stylesheet" href="/Modernize-1.0.0/Modernize-1.0.0/src/assets/css/styles.min.css" />
</head>
<body>
    <div class="page-wrapper" id="main-wrapper" data-layout="vertical" data-navbarbg="skin6" data-sidebartype="full" data-sidebar-position="fixed" data-header-position="fixed">
        @await Html.PartialAsync("_sidebar");
        <div class="body-wrapper">
            <header class="app-header">
                <nav class="navbar navbar-expand-lg navbar-light">
                    <ul class="navbar-nav">
                        <li class="nav-item d-block d-xl-none">
                            <a class="nav-link sidebartoggler nav-icon-hover" id="headerCollapse" href="javascript:void(0)">
                                <i class="ti ti-menu-2"></i>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-icon-hover" href="javascript:void(0)">
                                <i class="ti ti-bell-ringing"></i>
                                <div class="notification bg-primary rounded-circle"></div>
                            </a>
                        </li>
                    </ul>
                    <div class="navbar-collapse justify-content-end px-0" id="navbarNav">
                        <ul class="navbar-nav flex-row ms-auto align-items-center justify-content-end">
                            <li class="nav-item dropdown">
                                <a class="nav-link nav-icon-hover" href="javascript:void(0)" id="drop2" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="../assets/images/profile/user-1.jpg" alt="" width="35" height="35" class="rounded-circle">
                                </a>
                                <div class="dropdown-menu dropdown-menu-end dropdown-menu-animate-up" aria-labelledby="drop2">
                                    <div class="message-body">
                                        <a href="javascript:void(0)" class="d-flex align-items-center gap-2 dropdown-item">
                                            <i class="ti ti-user fs-6"></i>
                                            <p class="mb-0 fs-3">My Profile</p>
                                        </a>
                                        <a href="javascript:void(0)" class="d-flex align-items-center gap-2 dropdown-item">
                                            <i class="ti ti-mail fs-6"></i>
                                            <p class="mb-0 fs-3">My Account</p>
                                        </a>
                                        <a href="javascript:void(0)" class="d-flex align-items-center gap-2 dropdown-item">
                                            <i class="ti ti-list-check fs-6"></i>
                                            <p class="mb-0 fs-3">My Task</p>
                                        </a>
                                        <a href="./authentication-login.html" class="btn btn-outline-primary mx-3 mt-2 d-block">Logout</a>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </nav>
            </header>
            <div class="container-fluid py-3">
                <h3 class="mb-3">Manage Coupons</h3>
                <!-- CHANGE: Thêm hiển thị TempData cho success/error từ Controller -->
                @if (ViewBag.Success != null) {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">@ViewBag.Success <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                }
                @if (ViewBag.Error != null) {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">@ViewBag.Error <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                }

                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 text-center p-3">
                            <div class="fs-4 fw-bold text-primary">@Model.Coupons.Count</div>
                            <div class="text-muted small">Total Coupons</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 text-center p-3">
                            <div class="fs-4 fw-bold text-success">@Model.Coupons.Count(c => c.EndDate > DateTime.Now)</div>
                            <div class="text-muted small">Active</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 text-center p-3">
                            <div class="fs-4 fw-bold text-warning">@Model.Coupons.Count(c => c.EndDate <= DateTime.Now)</div>
                            <div class="text-muted small">Expired</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 text-center p-3">
                            <div class="fs-4 fw-bold text-info">@(Model.Coupons.Sum(c => c.MaxUsage ?? 0).ToString("N0"))</div> <!-- CHANGE: Fixed CS1501 - Handle nullable int? with ?? 0 before Sum, now Sum returns non-nullable int for ToString("N0") -->
                            <div class="text-muted small">Total Max Usage</div>
                        </div>
                    </div>
                </div>
                <!-- CHANGE: Search & Sort Form (to English) -->
                <form asp-action="ManageCoupon" method="get" class="row g-2 mb-3 align-items-end">
                    <!-- CHANGE: Sửa asp-action -->
                    <div class="col-md-3">
                        <label class="form-label">Search Code</label>
                        <input name="Search" class="form-control" placeholder="Enter code..." />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Sort By</label>
                        <select name="Sort" class="form-select">
                            <option value="">Default</option>
                            <option value="code">By Code</option>
                            <option value="discount">By Discount %</option>
                            <option value="endDate">By End Date</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">&nbsp;</label>
                        <button type="submit" class="btn btn-primary w-100">Filter</button>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">&nbsp;</label>
                        <a asp-action="ManageCoupon" class="btn btn-outline-secondary w-100">Clear</a> <!-- CHANGE: Sửa asp-action -->
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">&nbsp;</label>
                        <button type="button" class="btn btn-success w-100" data-bs-toggle="modal" data-bs-target="#createModal">Create New</button>
                    </div>
                </form>
                <!-- CHANGE: Table (English headers; fixed date ToString to "MM/dd/yyyy" for English format; handle nullable DiscountPercent with ?? 0) -->
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Code</th>
                                        <th>% Discount</th>
                                        <th>Start Date</th>
                                        <th>End Date</th>
                                        <th>Max Usage</th>
                                        <th>Product ID</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in Model.CouponsPage) {
                                        <tr>
                                            <td>@c.Id</td>
                                            <td>@(c.Code ?? "")</td> <!-- CHANGE: Handle nullable string -->
                                            <td>@(c.DiscountPercent ?? 0) %</td> <!-- CHANGE: Handle nullable decimal with ?? 0 to avoid runtime error -->
                                            <td>@(c.StartDate?.ToString("MM/dd/yyyy") ?? "")</td> <!-- CHANGE: Fixed ToString format for English -->
                                            <td>@(c.EndDate?.ToString("MM/dd/yyyy") ?? "")</td> <!-- CHANGE: Fixed ToString format for English -->
                                            <td>@(c.MaxUsage ?? 0)</td> <!-- CHANGE: Handle nullable int -->
                                            <td>@(c.ProductId ?? 0)</td> <!-- CHANGE: Handle nullable int -->
                                            <td>
                                                <button class="btn btn-sm btn-info" data-bs-toggle="modal" data-bs-target="#detailModal-@c.Id">Detail</button>
                                                <button class="btn btn-sm btn-warning" data-bs-toggle="modal" data-bs-target="#editModal-@c.Id">Edit</button>
                                                <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@c.Id">Delete</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <!-- CHANGE: Pagination (assume ViewBag.CurrentPage set in Controller) -->
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                @for (int i = 1; i <= Model.TotalPages; i++) {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="ManageCoupon" asp-route-page="@i">@i</a> <!-- CHANGE: Sửa asp-action -->
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                </div>

                <!-- CHANGE: CREATE Modal (English text; handle nullable in select/value if needed) -->
                <div class="modal fade" id="createModal" tabindex="-1">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <form asp-action="Create" method="post">
                                @Html.AntiForgeryToken()
                                <div class="modal-header bg-success text-white">
                                    <h5 class="modal-title">Create New Coupon</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="mb-3">
                                        <label class="form-label">Code</label>
                                        <input name="Code" class="form-control" required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">% Discount (0-100)</label>
                                        <input name="DiscountPercent" type="number" min="0" max="100" step="0.01" class="form-control" required /> <!-- CHANGE: Added step="0.01" for decimal -->
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Start Date</label>
                                        <input name="StartDate" type="date" class="form-control" required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">End Date</label>
                                        <input name="EndDate" type="date" class="form-control" required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Max Usage</label>
                                        <input name="MaxUsage" type="number" min="1" class="form-control" required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Product ID (Attach to)</label>
                                        <select name="ProductId" class="form-select" required>
                                            <option value="">Select Product</option>
                                            @foreach (var p in ViewBag.Products ?? new List<Product>()) {
                                                <option value="@p.Id">@p.Title</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-success">Create</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                @foreach (var c in Model.Coupons) {
                    <!-- CHANGE: Detail Modal (English; handle nullable in display) -->
                    <div class="modal fade" id="detailModal-@c.Id" tabindex="-1">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header bg-info text-white">
                                    <h5 class="modal-title">Detail: @(c.Code ?? "N/A")</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <p><strong>% Discount:</strong> @(c.DiscountPercent ?? 0)</p>
                                    <p><strong>Start:</strong> @(c.StartDate?.ToString("MM/dd/yyyy") ?? "")</p>
                                    <p><strong>End:</strong> @(c.EndDate?.ToString("MM/dd/yyyy") ?? "")</p>
                                    <p><strong>Max Usage:</strong> @(c.MaxUsage ?? 0)</p>
                                    <p><strong>Product ID:</strong> @(c.ProductId ?? 0)</p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CHANGE: Edit Modal (full fields, fixed 'Field' error by using actual properties; English; handle nullable value with ?? 0 or empty) -->
                    <div class="modal fade" id="editModal-@c.Id" tabindex="-1">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <form asp-action="Edit" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@c.Id" />
                                    <div class="modal-header">
                                        <h5 class="modal-title">Edit: @(c.Code ?? "N/A")</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="mb-3">
                                            <label class="form-label">Code</label>
                                            <input name="Code" class="form-control" value="@(c.Code ?? "")" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">% Discount (0-100)</label>
                                            <input name="DiscountPercent" type="number" min="0" max="100" step="0.01" class="form-control" value="@(c.DiscountPercent?.ToString("F2") ?? "")" required /> <!-- CHANGE: Handle nullable decimal with ?.ToString("F2") for input -->
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Start Date</label>
                                            <input name="StartDate" type="date" class="form-control" value="@(c.StartDate?.ToString("yyyy-MM-dd") ?? "")" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">End Date</label>
                                            <input name="EndDate" type="date" class="form-control" value="@(c.EndDate?.ToString("yyyy-MM-dd") ?? "")" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Max Usage</label>
                                            <input name="MaxUsage" type="number" min="1" class="form-control" value="@(c.MaxUsage ?? 0)" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Product ID (Attach to)</label>
                                            <select name="ProductId" class="form-select" required>
                                                <option value="">Select Product</option>
                                                @foreach (var p in ViewBag.Products ?? new List<Product>()) {
                                                    <option value="@p.Id" selected="@(p.Id == c.ProductId)">@p.Title</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary">Update</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- CHANGE: Delete Modal (English; handle nullable Code) -->
                    <div class="modal fade" id="deleteModal-@c.Id" tabindex="-1">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <form asp-action="Delete" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@c.Id" />
                                    <div class="modal-header bg-danger text-white">
                                        <h5 class="modal-title">Delete Coupon</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Are you sure you want to delete <strong>@(c.Code ?? "N/A")</strong>?</p>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-danger">Delete</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }

                <script src="/Modernize-1.0.0/Modernize-1.0.0/src/assets/libs/jquery/dist/jquery.min.js"></script>
                <script src="/Modernize-1.0.0/Modernize-1.0.0/src/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
                <script src="/Modernize-1.0.0/Modernize-1.0.0/src/assets/js/sidebarmenu.js"></script>
                <script src="/Modernize-1.0.0/Modernize-1.0.0/src/assets/js/app.min.js"></script>
                <script src="/Modernize-1.0.0/Modernize-1.0.0/src/assets/libs/simplebar/dist/simplebar.js"></script>
            </div>
        </div>
    </div>
</body>
</html>