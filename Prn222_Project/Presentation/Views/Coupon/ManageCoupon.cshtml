@model Presentation.ViewModel.CouponVM
@using DataAccess.Models
@using Presentation.ViewModel

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Manage Coupons - Modernize Free</title>
    <link rel="shortcut icon" type="image/png" href="/Modernize-1.0.0/Modernize-1.0.0/src/assets/images/logos/favicon.png" />
    <link rel="stylesheet" href="/Modernize-1.0.0/Modernize-1.0.0/src/assets/css/styles.min.css" />
</head>
<body>
    <div class="page-wrapper" id="main-wrapper" data-layout="vertical" data-navbarbg="skin6" data-sidebartype="full" data-sidebar-position="fixed" data-header-position="fixed">
        @await Html.PartialAsync("_sidebar");
        <div class="body-wrapper">
            <header class="app-header">
                <nav class="navbar navbar-expand-lg navbar-light">
                    <ul class="navbar-nav">
                        <li class="nav-item d-block d-xl-none">
                            <a class="nav-link sidebartoggler nav-icon-hover" id="headerCollapse" href="javascript:void(0)">
                                <i class="ti ti-menu-2"></i>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link nav-icon-hover" href="javascript:void(0)">
                                <i class="ti ti-bell-ringing"></i>
                                <div class="notification bg-primary rounded-circle"></div>
                            </a>
                        </li>
                    </ul>

                    <div class="navbar-collapse justify-content-end px-0" id="navbarNav">
                        <ul class="navbar-nav flex-row ms-auto align-items-center justify-content-end">
                            <li class="nav-item dropdown">
                                <a class="nav-link nav-icon-hover" href="javascript:void(0)" id="drop2" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="../assets/images/profile/user-1.jpg" alt="" width="35" height="35" class="rounded-circle">
                                </a>

                                <div class="dropdown-menu dropdown-menu-end dropdown-menu-animate-up" aria-labelledby="drop2">
                                    <div class="message-body">
                                        <a href="javascript:void(0)" class="d-flex align-items-center gap-2 dropdown-item">
                                            <i class="ti ti-user fs-6"></i>
                                            <p class="mb-0 fs-3">My Profile</p>
                                        </a>

                                        <a href="javascript:void(0)" class="d-flex align-items-center gap-2 dropdown-item">
                                            <i class="ti ti-mail fs-6"></i>
                                            <p class="mb-0 fs-3">My Account</p>
                                        </a>

                                        <a href="javascript:void(0)" class="d-flex align-items-center gap-2 dropdown-item">
                                            <i class="ti ti-list-check fs-6"></i>
                                            <p class="mb-0 fs-3">My Task</p>
                                        </a>
                                        <a href="./authentication-login.html" class="btn btn-outline-primary mx-3 mt-2 d-block">Logout</a>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </nav>
            </header>

            <div class="container-fluid py-3">
                <h3 class="mb-3">Manage Coupons</h3>
                @if (ViewBag.Success != null) {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">@ViewBag.Success <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                }
                @if (ViewBag.Error != null) {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">@ViewBag.Error <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                }

                @* kpi cards *@
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 text-center p-3">
                            <div class="fs-4 fw-bold text-primary">@Model.Coupons.Count</div>
                            <div class="text-muted small">Total Coupons</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 text-center p-3">
                            <div class="fs-4 fw-bold text-success">@Model.Coupons.Count(c => c.EndDate > DateTime.Now)</div>
                            <div class="text-muted small">Active</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 text-center p-3">
                            <div class="fs-4 fw-bold text-warning">@Model.Coupons.Count(c => c.EndDate <= DateTime.Now)</div>
                            <div class="text-muted small">Expired</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 text-center p-3">
                            <div class="fs-4 fw-bold text-info">@(Model.Coupons.Sum(c => c.MaxUsage ?? 0).ToString("N0"))</div>
                            <div class="text-muted small">Total Max Usage</div>
                        </div>
                    </div>
                </div>

                @* filter form *@
                <form asp-action="ManageCoupon" method="get" class="row g-2 mb-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Search Code</label>
                        <input name="search" class="form-control" placeholder="Enter code..." value="@ViewBag.Search" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Max Usage (Exact)</label>
                        <input name="maxUsageSearch" type="number" min="0" class="form-control" value="@ViewBag.MaxUsageSearch" placeholder="e.g., 50" /> <!-- CHANGE: Thêm search Max Usage exact -->
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Product ID</label>
                        <select name="productIdSearch" class="form-select">
                            <option value="">All Products</option>
                            @foreach (var p in ViewBag.Products ?? new List<Product>()) {
                                <option value="@p.Id" selected="@(p.Id == ViewBag.ProductIdSearch)">@p.Title (ID: @p.Id)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Sort By</label>
                        <select name="sort" class="form-select">
                            <option value="">Default</option>
                            <option value="code" selected="@(ViewBag.Sort == "code")">Code</option>
                            <option value="discount" selected="@(ViewBag.Sort == "discount")">Discount %</option>
                            <option value="startDate" selected="@(ViewBag.Sort == "startDate")">Start Date</option> <!-- CHANGE: Thêm sort Start Date -->
                            <option value="endDate" selected="@(ViewBag.Sort == "endDate")">End Date</option>
                            <option value="maxUsage" selected="@(ViewBag.Sort == "maxUsage")">Max Usage</option> <!-- CHANGE: Thêm sort Max Usage -->
                            <option value="productId" selected="@(ViewBag.Sort == "productId")">Product ID</option> <!-- CHANGE: Thêm sort Product ID -->
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Sort Direction</label>
                        <select name="direction" class="form-select">
                            <option value="asc" selected="@(ViewBag.Direction == "asc")">ASC</option>
                            <option value="desc" selected="@(ViewBag.Direction == "desc")">DESC</option>
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-2">
                            <label class="form-label">&nbsp;</label>
                            <button type="submit" class="btn btn-primary w-100">Filter</button>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">&nbsp;</label>
                            <a asp-action="ManageCoupon" class="btn btn-outline-secondary w-100">Clear</a>
                        </div>

                        <div class="col-md-2 **ms-auto**">
                            <label class="form-label">&nbsp;</label>
                            <button type="button" class="btn btn-success w-100" data-bs-toggle="modal" data-bs-target="#createModal">Create New</button>
                        </div>
                    </div>
                    
                </form>

                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Code</th>
                                        <th>% Discount</th>
                                        <th>Start Date</th>
                                        <th>End Date</th>
                                        <th>Max Usage</th>
                                        <th>Product ID</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.CouponsPage.Any()) {
                                        @foreach (var c in Model.CouponsPage) {
                                            <tr>
                                                <td>@c.Id</td>
                                                <td>@(c.Code ?? "")</td>
                                                <td>@(c.DiscountPercent ?? 0) %</td>
                                                <td>@(c.StartDate?.ToString("MM/dd/yyyy") ?? "")</td>
                                                <td>@(c.EndDate?.ToString("MM/dd/yyyy") ?? "")</td>
                                                <td>@(c.MaxUsage ?? 0)</td>
                                                <td>@(c.ProductId ?? 0)</td>
                                                <td>
                                                    <button class="btn btn-sm btn-info me-1" data-bs-toggle="modal" data-bs-target="#detailModal-@c.Id">Detail</button>
                                                    <button class="btn btn-sm btn-warning me-1" data-bs-toggle="modal" data-bs-target="#editModal-@c.Id">Edit</button>
                                                    <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@c.Id">Delete</button>
                                                </td>
                                            </tr>
                                        }
                                    } else {
                                        <tr>
                                            <td colspan="8" class="text-center text-muted">No coupons found. Create one to get started!</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @* pagination *@
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center">
                                @for (int i = 1; i <= Model.TotalPages; i++) {
                                    <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                        <a class="page-link" asp-action="ManageCoupon" asp-route-page="@i">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                </div>

                @* modal create *@
                <div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-lg">
                        <div class="modal-content">
                            <form asp-action="Create" method="post" novalidate>
                                @Html.AntiForgeryToken()
                                <div class="modal-header bg-success text-white">
                                    <h5 class="modal-title" id="createModalLabel">Create New Coupon</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label">Code <span class="text-danger">*</span></label>
                                            <input name="Code" class="form-control" required pattern="[a-zA-Z0-9_]{4,10}" title="4-10 letters (a-zA-Z), numbers, underscores" />
                                            <div class="invalid-feedback">Code is required and must be unique.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">% Discount <span class="text-danger">*</span></label>
                                            <input name="DiscountPercent" type="number" min="0" max="100" step="0.01" class="form-control" required />
                                            <div class="invalid-feedback">Between 0 and 100.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Start Date <span class="text-danger">*</span></label>
                                            <input name="StartDate" type="date" class="form-control" required />
                                            <div class="invalid-feedback">Start date is required.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">End Date <span class="text-danger">*</span></label>
                                            <input name="EndDate" type="date" class="form-control" required />
                                            <div class="invalid-feedback">End date must be after start date.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Max Usage <span class="text-danger">*</span></label>
                                            <input name="MaxUsage" type="number" min="1" class="form-control" required />
                                            <div class="invalid-feedback">Positive integer.</div>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label">Product ID <span class="text-danger">*</span></label>
                                            <select name="ProductId" class="form-select" required>
                                                <option value="">Select Product</option>
                                                @foreach (var p in ViewBag.Products ?? new List<Product>()) {
                                                    <option value="@p.Id">@p.Title (ID: @p.Id)</option>
                                                }
                                            </select>
                                            <div class="invalid-feedback">Select a product.</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-success">Create</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                @foreach (var c in Model.Coupons) {
                    @* modal detail *@
                    <div class="modal fade" id="detailModal-@c.Id" tabindex="-1">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header bg-info text-white">
                                    <h5 class="modal-title">Detail Coupon: @(c.Code ?? "N/A")</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <dl class="row">
                                        <dt class="col-sm-4">ID</dt>
                                        <dd class="col-sm-8">@c.Id</dd>
                                        <dt class="col-sm-4">Code</dt>
                                        <dd class="col-sm-8">@(c.Code ?? "N/A")</dd>
                                        <dt class="col-sm-4">% Discount</dt>
                                        <dd class="col-sm-8">@(c.DiscountPercent ?? 0) %</dd>
                                        <dt class="col-sm-4">Start Date</dt>
                                        <dd class="col-sm-8">@(c.StartDate?.ToString("MM/dd/yyyy") ?? "N/A")</dd>
                                        <dt class="col-sm-4">End Date</dt>
                                        <dd class="col-sm-8">@(c.EndDate?.ToString("MM/dd/yyyy") ?? "N/A")</dd>
                                        <dt class="col-sm-4">Max Usage</dt>
                                        <dd class="col-sm-8">@(c.MaxUsage ?? 0)</dd>
                                        <dt class="col-sm-4">Product ID</dt>
                                        <dd class="col-sm-8">@(c.ProductId ?? 0)</dd>
                                    </dl>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* modal edit *@
                    <div class="modal fade" id="editModal-@c.Id" tabindex="-1" aria-labelledby="editModalLabel-@c.Id" aria-hidden="true">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content">
                                <form asp-action="Update" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@c.Id" />
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="editModalLabel-@c.Id">Edit Coupon: @(c.Code ?? "N/A")</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <label class="form-label">Code <span class="text-danger">*</span></label>
                                                <input name="Code" class="form-control" value="@(c.Code ?? "")" required pattern="[a-zA-Z0-9_]{4,10}" title="4-10 letters (a-zA-Z), numbers, underscores" />
                                                <div class="invalid-feedback">Code is required and must be unique.</div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">% Discount <span class="text-danger">*</span></label>
                                                <input name="DiscountPercent" type="number" min="0" max="100" step="0.01" class="form-control" value="@(c.DiscountPercent?.ToString("F2") ?? "")" required />
                                                <div class="invalid-feedback">Between 0 and 100.</div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Start Date <span class="text-danger">*</span></label>
                                                <input name="StartDate" type="date" class="form-control" value="@(c.StartDate?.ToString("yyyy-MM-dd") ?? "")" required />
                                                <div class="invalid-feedback">Start date is required.</div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">End Date <span class="text-danger">*</span></label>
                                                <input name="EndDate" type="date" class="form-control" value="@(c.EndDate?.ToString("yyyy-MM-dd") ?? "")" required />
                                                <div class="invalid-feedback">End date must be after start date.</div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Max Usage <span class="text-danger">*</span></label>
                                                <input name="MaxUsage" type="number" min="1" class="form-control" value="@(c.MaxUsage ?? 0)" required />
                                                <div class="invalid-feedback">Positive integer.</div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label">Product ID <span class="text-danger">*</span></label>
                                                <select name="ProductId" class="form-select" required>
                                                    <option value="">Select Product</option>
                                                    @foreach (var p in ViewBag.Products ?? new List<Product>()) {
                                                        <option value="@p.Id" selected="@(p.Id == c.ProductId)">@p.Title (ID: @p.Id)</option>
                                                    }
                                                </select>
                                                <div class="invalid-feedback">Select a product.</div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary">Update</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    @* modal delete *@
                    <div class="modal fade" id="deleteModal-@c.Id" tabindex="-1">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <form asp-action="Delete" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@c.Id" />
                                    <div class="modal-header bg-danger text-white">
                                        <h5 class="modal-title">Delete Coupon</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Are you sure you want to delete <strong>@(c.Code ?? "N/A")</strong>?</p>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-danger">Delete</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }

                <script src="/Modernize-1.0.0/Modernize-1.0.0/src/assets/libs/jquery/dist/jquery.min.js"></script>
                <script src="/Modernize-1.0.0/Modernize-1.0.0/src/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
                <script src="/Modernize-1.0.0/Modernize-1.0.0/src/assets/js/sidebarmenu.js"></script>
                <script src="/Modernize-1.0.0/Modernize-1.0.0/src/assets/js/app.min.js"></script>
                <script src="/Modernize-1.0.0/Modernize-1.0.0/src/assets/libs/simplebar/dist/simplebar.js"></script>
                <script>
                    // validation bootstrap
                    (function () {
                        'use strict';
                        window.addEventListener('load', function () {
                            var forms = document.getElementsByClassName('needs-validation');
                            var validation = Array.prototype.filter.call(forms, function (form) {
                                form.addEventListener('submit', function (event) {
                                    if (form.checkValidity() === false) {
                                        event.preventDefault();
                                        event.stopPropagation();
                                    }
                                    form.classList.add('was-validated');
                                }, false);
                            });
                        }, false);
                    })();
                </script>
            </div>
        </div>
    </div>
</body>
</html>