@model IEnumerable<BusinessLogic.DTOs.Response.Dispute.DisputeResponse>

@{
    ViewData["Title"] = "Manage Disputes";
    var index = 1;
}

<div class="page-wrapper" id="main-wrapper"
     data-layout="vertical" data-navbarbg="skin6"
     data-sidebartype="full" data-sidebar-position="fixed"
     data-header-position="fixed">

    @await Html.PartialAsync("_sidebar")

    <div class="body-wrapper">

        <!-- Header -->
        <header class="app-header">
            <nav class="navbar navbar-expand-lg navbar-light">
                <ul class="navbar-nav">
                    <li class="nav-item d-block d-xl-none">
                        <a class="nav-link sidebartoggler nav-icon-hover" id="headerCollapse" href="javascript:void(0)">
                            <i class="ti ti-menu-2"></i>
                        </a>
                    </li>
                </ul>

                <div class="navbar-collapse justify-content-end px-0" id="navbarNav">
                    <ul class="navbar-nav flex-row ms-auto align-items-center justify-content-end">
                        <li class="nav-item dropdown">
                            <a class="nav-link nav-icon-hover" href="javascript:void(0)" id="drop2"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="../assets/images/profile/user-1.jpg" alt="" width="35" height="35" class="rounded-circle" />
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>
        </header>


        <!-- MAIN CONTENT -->
        <div class="container-fluid py-3">

            <h3 class="fw-bold mb-3">Disputes</h3>


            <!-- 🔍 SEARCH FILTER -->
            <div class="card mb-3">
                <div class="card-body">
                    <form method="get" asp-action="ManageDispute" class="row g-3">

                        <div class="col-md-4">
                            <label class="form-label mb-1">Disputer</label>
                            <input type="text"
                                   name="disputer"
                                   class="form-control"
                                   value="@ViewBag.Disputer"
                                   placeholder="Search by disputer name..." />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label mb-1">Product</label>
                            <input type="text"
                                   name="product"
                                   class="form-control"
                                   value="@ViewBag.Product"
                                   placeholder="Search by product name..." />
                        </div>

                        <div class="col-md-2 d-grid align-items-end">
                            <button type="submit" class="btn btn-primary mt-4">Search</button>
                        </div>

                        <div class="col-md-2 d-grid align-items-end">
                            <a href="@Url.Action("ManageDispute","Dispute")"
                               class="btn btn-outline-secondary mt-4">Clear</a>
                        </div>

                    </form>
                </div>
            </div>


            <!-- TABLE -->
            <div class="card">
                <div class="card-body">
                    <table class="table table-striped align-middle">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Disputer</th>
                                <th>Product</th>
                                <th>Status</th>
                                <th style="width: 120px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted">No disputes found.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var d in Model)
                                {
                                    <tr>
                                        <td>@index</td>
                                        <td>@d.DisputerName</td>
                                        <td>@d.ProductTitles</td>
                                        <td>@d.Status</td>
                                        <td>
                                            <a asp-action="DisputeDetail" asp-route-id="@d.Id"
                                               class="btn btn-sm btn-primary">Detail</a>
                                        </td>
                                    </tr>
                                    index++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </div> <!-- /container-fluid -->
    </div> <!-- /body-wrapper -->
</div> <!-- /page-wrapper -->
