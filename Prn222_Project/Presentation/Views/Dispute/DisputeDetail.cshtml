@model BusinessLogic.DTOs.Response.Dispute.DisputeResponse

@{
	ViewData["Title"] = "Dispute Detail";
}

<div class="container-fluid py-3">
	<a asp-action="ManageDispute" class="btn btn-link mb-3">&laquo; Back to list</a>

	<div class="row g-4">
		<!-- Info -->
		<div class="col-lg-8">
			<div class="card mb-3">
				<div class="card-header">
					<strong>Order Information</strong>
				</div>
				<div class="card-body">
					<p><strong>Order ID:</strong> #@Model.OrderId</p>
					<p><strong>Order Date:</strong> @Model.OrderDate?.ToString("dd/MM/yyyy")</p>
					<p><strong>Total Price:</strong> @Model.TotalPrice?.ToString("N0")</p>
					<p>
						<strong>Disputer:</strong>
						@if (!string.IsNullOrEmpty(Model.DisputerName))
						{
							@Model.DisputerName
						}
						else
						{
							@Model.DisputerId
						}
					</p>
					<p><strong>Product(s):</strong> @Model.ProductTitles</p>
					<p><strong>Current Status:</strong> @Model.Status</p>
					<p><strong>Resolution:</strong> @Model.Resolution</p>
				</div>
			</div>

			<div class="card">
				<div class="card-header">
					<strong>Dispute Description</strong>
				</div>
				<div class="card-body">
					<p>@Model.Description</p>
				</div>
			</div>
		</div>

		<!-- Action -->
		<div class="col-lg-4">
			<div class="card">
				<div class="card-header">
					<strong>Actions</strong>
				</div>
				<div class="card-body d-grid gap-2">
					<button type="button"
							class="btn btn-success"
							data-bs-toggle="modal"
							data-bs-target="#acceptModal">
						Accept
					</button>

					<button type="button"
							class="btn btn-danger"
							data-bs-toggle="modal"
							data-bs-target="#rejectModal">
						Reject
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Accept Modal -->
<div class="modal fade" id="acceptModal" tabindex="-1" aria-labelledby="acceptModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<form asp-action="Accept" method="post" class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="acceptModalLabel">Accept dispute</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<input type="hidden" name="id" value="@Model.Id" />

				<div class="mb-3">
					<label class="form-label">Refund type</label><br />
					<div class="form-check">
						<input class="form-check-input" type="radio" name="refundType" id="fullRefund" value="100% refund" checked>
						<label class="form-check-label" for="fullRefund">
							100% refund
						</label>
					</div>
					<div class="form-check">
						<input class="form-check-input" type="radio" name="refundType" id="partialRefund" value="Partial refund">
						<label class="form-check-label" for="partialRefund">
							Partial refund
						</label>
					</div>
				</div>

				<div class="mb-3">
					<label class="form-label">Email content to buyer</label>
					<textarea name="emailBody" class="form-control" rows="4"
							  placeholder="Nội dung email bạn muốn gửi cho buyer..."></textarea>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="submit" class="btn btn-success">Confirm Accept</button>
			</div>
		</form>
	</div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<form asp-action="Reject" method="post" class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="rejectModalLabel">Reject dispute</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<input type="hidden" name="id" value="@Model.Id" />

				<div class="mb-3">
					<label class="form-label">Reason (saved to resolution)</label>
					<textarea name="reason" class="form-control" rows="3"
							  placeholder="Lý do reject (sẽ lưu vào Resolution)..."></textarea>
				</div>

				<div class="mb-3">
					<label class="form-label">Email content to buyer</label>
					<textarea name="emailBody" class="form-control" rows="4"
							  placeholder="Nội dung email bạn muốn gửi cho buyer..."></textarea>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
				<button type="submit" class="btn btn-danger">Confirm Reject</button>
			</div>
		</form>
	</div>
</div>
