@using Common.Enums
@using Presentation.ViewModel.Data.Category
@model Presentation.ViewModel.Params.Inventory.SearchParams

@{
    var categories = ViewData["Categories"] as List<SelectListItem>;
}

<div class="card">
    <div class="card-body">
        <div class="row">
            <!-- Filter 1: Search Term -->
            <div class="col-md-4 mb-3">
                <label asp-for="SearchTerm" class="form-label">Product name</label>
                <input asp-for="SearchTerm" class="form-control" placeholder="Enter product name...">
            </div>

            <!-- Filter 2: Category -->
            <div class="col-md-3 mb-3">
                <label asp-for="CategoryId" class="form-label">Category</label>
                <select asp-for="CategoryId" asp-items="@categories" class="form-select"></select>
            </div>

            <!-- Filter 3: Stock Status -->
            <div class="col-md-3 mb-3">
                <label asp-for="StockStatus" class="form-label">Stock Status</label>
                <select asp-for="StockStatus" class="form-select">
                    <option value="@StockStatusEnum.All">All Status</option>
                    <option value="@StockStatusEnum.InStock">In Stock</option>
                    <option value="@StockStatusEnum.OutOfStock">Out of Stock</option>
                    <option value="@StockStatusEnum.LowStock">Low Stock (Less than 5)</option>
                </select>
            </div>

            <!-- Buttons -->
            <div class="col-md-2 d-flex align-items-end mb-3">
                <button type="submit" id="filter-btn" class="btn btn-primary me-2">Search</button>
                <button type="button" id="reset-btn" class="btn btn-outline-secondary">Reset</button>
            </div>

            <input type="hidden" asp-for="Pagination.PageIndex" />
            <input type="hidden" asp-for="Pagination.PageSize" />
        </div>
    </div>
</div>
