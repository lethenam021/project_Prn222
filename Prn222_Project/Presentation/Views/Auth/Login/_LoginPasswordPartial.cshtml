@model Presentation.ViewModel.Params.Auth.LoginParams
<h1 class="form-title">Welcome</h1>

<div class="welcome-user">
    <span>@Model.Email</span>
    <!-- Link để quay lại Bước 1 -->
    <a href="#" id="change-user-link">(Change user)</a>
</div>

<form id="login-password-form" asp-controller="Auth" asp-action="Login" method="post">

    <!-- Gửi email đi một cách ẩn -->
    <input type="hidden" asp-for="Email" />
    <!-- Bạn cũng nên gửi "StaySignedIn" nếu cần -->
    <!-- Vùng hiển thị lỗi (ví dụ: "Mật khẩu sai") -->
    <div id="password-error-alert" class="alert alert-danger d-none mb-3 p-2"></div>

    <div class="form-group">
        <label asp-for="Password" class="form-label">Password</label>
        <input asp-for="Password" class="form-input" autofocus>
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>

    <a asp-action="ForgotPassword" class="forgot-password">Forgot password?</a>

    <button type="submit" id="password-signin-btn" class="btn btn-primary">Sign In</button>
</form>