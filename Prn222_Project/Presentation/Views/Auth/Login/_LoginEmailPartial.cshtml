@model Presentation.ViewModel.Params.Auth.LoginParams

<form id="login-email-form" asp-controller="Auth" asp-action="CheckEmail" method="post">

    <div class="form-group">
        <label for="email" class="form-label">Email</label>
        <input id="email" asp-for="Email" class="form-input">
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <br />
    <button type="submit" id="email-continue-btn" class="w-100 btn btn-primary px-4 py-2">Continue</button>
</form>

<div class="separator">
    <div class="w-100 separator-line animate"></div>
    <div class="separator-content animate text-center">
        <mark>
            <span>or</span>
        </mark>
    </div>
</div>

<div class="mb-3">
    <a class="btn btn-social d-flex align-items-center border-1 border-dark border py-2">
        <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google">
        <span class="flex-grow-1 me-4">Continue with Google</span>
    </a>
</div>

<div class="d-flex align-items-center flex-column">
    <div class="d-flex align-items-center align-items-center">
        <div class="me-2">
            <input asp-for="RememberMe" id="remember-me" class="form-check-input" />
            <label for="remember-me" class="form-check-label">Stay signed in</label>
        </div>
        <span class="tooltip-icon" data-bs-toggle="tooltip" title="For your security, you'll be asked to sign in occasionally.">
            <i class="fas fa-info-circle"></i>
        </span>
    </div>
</div>