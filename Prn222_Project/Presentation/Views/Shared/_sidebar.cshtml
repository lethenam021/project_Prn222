<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@latest/dist/tabler-icons.min.css">

<!-- Sidebar Start -->
<aside class="left-sidebar">
	<!-- Sidebar scroll-->
	<div>
		<div class="brand-logo d-flex align-items-center justify-content-between">
			<a asp-controller="Report" asp-action="ManageReport" class="logo-img d-block w-100 text-nowrap py-3 text-center">
				<img src="https://upload.wikimedia.org/wikipedia/commons/1/1b/EBay_logo.svg" alt="eBay Logo" width="117" height="48">
			</a>
			<div class="close-btn d-xl-none d-block sidebartoggler cursor-pointer" id="sidebarCollapse">
				<i class="ti ti-x fs-8"></i>
			</div>
		</div>
		<!-- Sidebar navigation-->
		<nav class="sidebar-nav scroll-sidebar" data-simplebar="">
			<ul id="sidebarnav">
				<li class="nav-small-cap">
					<i class="ti ti-dots nav-small-cap-icon fs-4"></i>
					<span class="hide-menu">Home</span>
				</li>
				<li class="sidebar-item">
					<a class="sidebar-link" asp-controller="Report" asp-action="ManageReport" aria-expanded="false">
						<span>
							<i class="bi bi-card-checklist"></i>
						</span>
						<span class="hide-menu">Sales and order reports</span>
					</a>
				</li>

				<li class="nav-small-cap">
					<i class="ti ti-dots nav-small-cap-icon fs-4"></i>
					<span class="hide-menu">MANAGEMENT</span>
				</li>
				<li class="sidebar-item">
					<a class="sidebar-link" asp-controller="Seller" asp-action="ManagerStore" aria-expanded="false">
						<span>
							<i class="ti ti-building-store"></i>
						</span>
						<span class="hide-menu">Store</span>
					</a>
				</li>
				<li class="sidebar-item">
					<a class="sidebar-link" asp-controller="Seller" asp-action="ManagerProduct" aria-expanded="false">
						<span>
							<i class="ti ti-package"></i>
						</span>
						<span class="hide-menu">Product</span>
					</a>
				</li>
				@* <li class="sidebar-item"> *@
				@*     <a class="sidebar-link" asp-controller="Report" asp-action="ManageReport" aria-expanded="false"> *@
				@*         <span> *@
				@*             <i class="bi bi-card-checklist"></i> *@
				@*         </span> *@
				@*         <span class="hide-menu">Sales and order reports</span> *@
				@*     </a> *@
				@* </li> *@
				<li class="sidebar-item">
					<a class="sidebar-link" asp-controller="Dispute" asp-action="ManageDispute" aria-expanded="false">
						<span>
							<i class="bi bi-journal-x"></i>
						</span>
						<span class="hide-menu">Dispute</span>
					</a>
				</li>
				<li class="sidebar-item">
					<a class="sidebar-link" href="@Url.Action("Index", "Inventory")" aria-expanded="false">
						<span>
							<i class="ti ti-building-warehouse"></i>
						</span>
						<span class="hide-menu">Inventory</span>
					</a>
				</li>
				<li class="sidebar-item">
					<a class="sidebar-link" href="@Url.Action("Index", "ProductReviews")" aria-expanded="false">
						<span>
							<i class="ti ti-eye-star"></i>
						</span>
						<span class="hide-menu">Product Reviews</span>
					</a>
				</li>
				<li class="nav-small-cap">
					<i class="ti ti-dots nav-small-cap-icon fs-4"></i>
					<span class="hide-menu">ACCOUNT</span>
				</li>
				<li class="sidebar-item">
					<a class="sidebar-link" asp-controller="Auth" asp-action="Logout" aria-expanded="false">
						<span>
							<i class="ti ti-login"></i>
						</span>
						<span class="hide-menu">Logout</span>
					</a>
				</li>
			</ul>
		</nav>
