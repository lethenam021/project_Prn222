@model List<Presentation.ViewModel.Data.ProductReviews.ProductReviewDetailViewModel>

@{
    var count = 0;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
<style>
    .rating-stars {
        color: #f1c40f;
    }

    .comment-truncate {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: normal;
        line-height: 1.5;
    }

        .comment-truncate.is-expanded {
            -webkit-line-clamp: unset;
            overflow: visible;
        }

    .read-more-link {
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        display: block;
        margin-top: 5px;
    }
</style>

<div class="card" id="review-detail-table-card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table-hover table">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>Reviewer</th>
                        <th>Rating</th>
                        <th>Comment</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any()) {
                        <tr>
                            <td colspan="6" class="text-center">No reviews found for this product/filter!</td>
                        </tr>
                    }

                    @foreach (var item in Model) {
                        count++;
                        <tr>
                            <td>@(item.StartIndex + count)</td>

                            <td>@item.Reviewer</td>

                            <td class="rating-stars">
                                @for (int i = 1; i <= 5; i++) {
                                    <i class="@(i <= item.Rating ? "fas fa-star text-warning" : "far fa-star text-warning")"></i>
                                }
                            </td>

                            <td>
                                <div class="comment-truncate">
                                    @item.Comment
                                </div>
                                @if (item.Comment != null && item.Comment.Length > 150) {
                                    <a class="read-more-link text-primary">Read More</a>
                                }
                            </td>

                            <td>
                                @item.ReviewDate.ToString("HH:mm dd/MM/yyyy")
                            </td>

                            <td>
                                <button class="btn btn-sm btn-outline-info send-feedback-btn"
                                        data-review-id="@(item.Id)"
                                        data-reviewer-name="@item.Reviewer">
                                    Send Feedback
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>