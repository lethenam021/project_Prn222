@using Presentation.ViewModel.Params.ProductReviews
@{
    ViewData["Title"] = "Product Reviews";
    // Lấy categories từ ViewBag (Controller cần cung cấp)
    var categories = ViewData["Categories"] as List<SelectListItem> ?? new List<SelectListItem>();
}

<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

<div class="page-wrapper" id="main-wrapper" data-layout="vertical" data-navbarbg="skin6" data-sidebartype="full"
     data-sidebar-position="fixed" data-header-position="fixed">
    @await Html.PartialAsync("_sidebar")
    <div class="body-wrapper">

        <div id="summary-view">
            <form id="review-filter-form" action="@Url.Action("SearchSummaries", "ProductReviews")">
                @await Html.PartialAsync("_ProductReviewsFilterPartial",
                new SearchSummaryParams(), ViewData)
                                
            </form>

            <div id="summary-table-container">
            </div>

            <div id="summary-pagination-container" class="mx-5">
            </div>
        </div>

        <div id="detail-view" style="display:none;">
        </div>

        <div class="modal fade" id="feedbackModal" tabindex="-1" aria-labelledby="feedbackModalTitle" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="feedbackModalTitle">Send Feedback</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="feedback-review-id" />

                        <label class="form-label">Your Reply:</label>

                        <div id="quill-editor" style="height: 200px;">
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" id="send-reply-btn">Send Reply</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="viewReplyModal" tabindex="-1" aria-labelledby="viewReplyModalTitle" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="viewReplyModalTitle">Seller's Reply</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body" id="view-reply-body" style="min-height: 200px;">
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<partial name="_ValidationScriptsPartial" />
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
<script src="/Modernize-1.0.0/Modernize-1.0.0/src/assets/js/sidebarmenu.js"></script>
<script src="~/js/pagination.js"></script>
<script src="~/js/product-reviews.js"></script>
}