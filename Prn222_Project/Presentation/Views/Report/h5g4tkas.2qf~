<body>
    <!-- Body Wrapper -->
    <div class="page-wrapper" id="main-wrapper"
         data-layout="vertical" data-navbarbg="skin6"
         data-sidebartype="full" data-sidebar-position="fixed"
         data-header-position="fixed">

        @await Html.PartialAsync("_sidebar")   <!-- Sidebar giống Manage Product -->
        <!-- Main wrapper -->
        <div class="body-wrapper">

            <!-- Header -->
            <header class="app-header">
                <nav class="navbar navbar-expand-lg navbar-light">
                    <ul class="navbar-nav">
                        <li class="nav-item d-block d-xl-none">
                            <a class="nav-link sidebartoggler nav-icon-hover" id="headerCollapse" href="javascript:void(0)">
                                <i class="ti ti-menu-2"></i>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-icon-hover" href="javascript:void(0)">
                                <i class="ti ti-bell-ringing"></i>
                                <div class="notification bg-primary rounded-circle"></div>
                            </a>
                        </li>
                    </ul>
                    <div class="navbar-collapse justify-content-end px-0" id="navbarNav">
                        <ul class="navbar-nav flex-row ms-auto align-items-center justify-content-end">
                            <li class="nav-item dropdown">
                                <a class="nav-link nav-icon-hover" href="javascript:void(0)" id="drop2" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="../assets/images/profile/user-1.jpg" alt="" width="35" height="35" class="rounded-circle">
                                </a>
                                <div class="dropdown-menu dropdown-menu-end dropdown-menu-animate-up" aria-labelledby="drop2">
                                    <div class="message-body">
                                        <a href="javascript:void(0)" class="d-flex align-items-center gap-2 dropdown-item">
                                            <i class="ti ti-user fs-6"></i><p class="mb-0 fs-3">My Profile</p>
                                        </a>
                                        <a href="javascript:void(0)" class="d-flex align-items-center gap-2 dropdown-item">
                                            <i class="ti ti-mail fs-6"></i><p class="mb-0 fs-3">My Account</p>
                                        </a>
                                        <a href="javascript:void(0)" class="d-flex align-items-center gap-2 dropdown-item">
                                            <i class="ti ti-list-check fs-6"></i><p class="mb-0 fs-3">My Task</p>
                                        </a>
                                        <a href="./authentication-login.html" class="btn btn-outline-primary mx-3 mt-2 d-block">Logout</a>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </nav>
            </header>

            <!-- ====== NỘI DUNG HIỆN TẠI CỦA BẠN (hai chart, KPI, bảng, v.v.) ====== -->
            <div class="container-fluid py-3">

                <style>
                    /* Chỉ là style nhẹ cho phần report, không ảnh hưởng sidebar */
                    .report-card {
                        border: 0;
                        border-radius: 16px;
                        box-shadow: 0 10px 25px rgba(0,0,0,.06);
                    }

                    .chart-box {
                        height: 320px;
                        border: 2px dashed #e5e7eb;
                        border-radius: 12px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        background: #fff;
                    }

                    .chart-note {
                        color: #94a3b8;
                        font-size: .95rem;
                    }

                    .metric-card {
                        border: 0;
                        border-radius: 14px;
                        box-shadow: 0 8px 20px rgba(0,0,0,.05);
                    }

                    .metric-value {
                        font-weight: 700;
                        font-size: 1.6rem;
                        color: #111827;
                    }

                    .metric-label {
                        color: #6b7280;
                        font-size: .9rem;
                    }

                    .badge-soft {
                        background: #eef2ff;
                        color: #4f46e5;
                    }
                </style>

                <!-- Header -->
                <div class="text-center mb-4">
                    <h3 class="fw-bold mb-2">Web Analytics Report</h3>
                    <div class="badge badge-soft rounded-pill px-3 py-2">Last 30 days</div>
                </div>

                <!-- Charts row -->
                <div class="row g-4 align-items-start">
                    <!-- Line chart -->
                    <div class="col-lg-7">
                        <div class="card report-card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="mb-0 text-muted">Sessions</h6>
                                    <span class="fw-semibold">6,302</span>
                                </div>
                                <div id="lineChart" class="chart-box">
                                    <span class="chart-note">Thêm chart line vào #lineChart</span>
                                </div>
                                <div class="d-flex justify-content-between mt-2 text-muted small">
                                    <span>18 Mar</span><span>1 Apr</span><span>8 Apr</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Donut chart (để thẳng) -->
                    <div class="col-lg-5">
                        <div class="card report-card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="mb-0 text-muted">Sessions</h6>
                                    <span class="fw-semibold">4,414</span>
                                </div>
                                <div id="donutChart" class="chart-box">
                                    <span class="chart-note">Thêm chart donut vào #donutChart</span>
                                </div>

                                <!-- Legend mẫu (tĩnh) -->
                                <div class="row row-cols-2 g-2 small text-muted mt-3">
                                    <div class="col">• Organic Search <span class="text-dark fw-semibold">697</span></div>
                                    <div class="col">• Direct <span class="text-dark fw-semibold">601</span></div>
                                    <div class="col">• Others <span class="text-dark fw-semibold">667</span></div>
                                    <div class="col">• Referral <span class="text-dark fw-semibold">559</span></div>
                                    <div class="col">• Social <span class="text-dark fw-semibold">640</span></div>
                                    <div class="col">• Paid Search <span class="text-dark fw-semibold">550</span></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Metrics -->
                <div class="row g-4 mt-1 mt-lg-4">
                    <div class="col-md-4">
                        <div class="card metric-card">
                            <div class="card-body text-center py-4">
                                <div class="metric-label mb-1">Avg. Sessions Durations</div>
                                <div class="metric-value">00:02:09</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card metric-card">
                            <div class="card-body text-center py-4">
                                <div class="metric-label mb-1">% Of New Sessions</div>
                                <div class="metric-value">14.82%</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card metric-card">
                            <div class="card-body text-center py-4">
                                <div class="metric-label mb-1">Bounce Rate</div>
                                <div class="metric-value">21.09%</div>
                            </div>
                        </div>
                    </div>
                </div>

                <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
                <script>
                    var options = {
                        chart: { type: 'line' },
                        series: [{
                            name: 'Sales',
                            data: [30, 40, 35, 50, 49, 60, 70, 91, 125]
                        }],
                        xaxis: {
                            categories: [1991, 1992, 1993, 1994, 1995, 1996, 1997, 1998, 1999]
                        }
                    };

                    var chart = new ApexCharts(document.querySelector("#lineChart"), options);
                    chart.render();
                </script>
            </div>
         

        </div> <!-- /body-wrapper -->
    </div> <!-- /page-wrapper -->
</body>
