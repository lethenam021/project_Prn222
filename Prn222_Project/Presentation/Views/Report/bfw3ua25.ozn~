@model IEnumerable<BusinessLogic.DTOs.Response.Report.ReportResponse>
@using System.Text.Json
@using System.Linq
@using Common.Enums

@{
    var dataList = Model?.ToList() ?? new List<BusinessLogic.DTOs.Response.Report.ReportResponse>();

    var labels = dataList.Select(x => x.Date.ToString("dd/MM")).ToList();
    var values = dataList
        .Select(x => Convert.ToDecimal(x.Statistics))
        .Cast<decimal>()
        .ToList();

    var labelsJson = JsonSerializer.Serialize(labels);
    var valuesJson = JsonSerializer.Serialize(values);

    var totalSum = values.Any() ? values.Sum() : 0;
    var maxValue = values.Any() ? values.Max() : 0;

    int currentMonth = ViewBag.Month;
    int currentWeek = ViewBag.Week;
    var rtType = (ReportTypeEnum)ViewBag.ReportType;
    var rtTime = (ReportTimeEnum)ViewBag.ReportTime;
}

<div class="page-wrapper" id="main-wrapper"
     data-layout="vertical" data-navbarbg="skin6"
     data-sidebartype="full" data-sidebar-position="fixed"
     data-header-position="fixed">

    @await Html.PartialAsync("_sidebar")

    <div class="body-wrapper">

        <!-- Header -->
        <header class="app-header">
            <nav class="navbar navbar-expand-lg navbar-light">
                <ul class="navbar-nav">
                    <li class="nav-item d-block d-xl-none">
                        <a class="nav-link sidebartoggler nav-icon-hover" id="headerCollapse" href="javascript:void(0)">
                            <i class="ti ti-menu-2"></i>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-icon-hover" href="javascript:void(0)">
                            <i class="ti ti-bell-ringing"></i>
                            <div class="notification bg-primary rounded-circle"></div>
                        </a>
                    </li>
                </ul>
                <div class="navbar-collapse justify-content-end px-0" id="navbarNav">
                    <ul class="navbar-nav flex-row ms-auto align-items-center justify-content-end">
                        <li class="nav-item dropdown">
                            <a class="nav-link nav-icon-hover" href="javascript:void(0)" id="drop2" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="../assets/images/profile/user-1.jpg" alt="" width="35" height="35" class="rounded-circle">
                            </a>
                            <div class="dropdown-menu dropdown-menu-end dropdown-menu-animate-up" aria-labelledby="drop2">
                                <div class="message-body">
                                    <a href="javascript:void(0)" class="d-flex align-items-center gap-2 dropdown-item">
                                        <i class="ti ti-user fs-6"></i><p class="mb-0 fs-3">My Profile</p>
                                    </a>
                                    <a href="javascript:void(0)" class="d-flex align-items-center gap-2 dropdown-item">
                                        <i class="ti ti-mail fs-6"></i><p class="mb-0 fs-3">My Account</p>
                                    </a>
                                    <a href="javascript:void(0)" class="d-flex align-items-center gap-2 dropdown-item">
                                        <i class="ti ti-list-check fs-6"></i><p class="mb-0 fs-3">My Task</p>
                                    </a>
                                    <a href="./authentication-login.html" class="btn btn-outline-primary mx-3 mt-2 d-block">Logout</a>
                                </div>
                            </div>
                        </li>
                    </ul>
                </div>
            </nav>
        </header>

        <div class="container-fluid py-3">

            <style>
                .report-card {
                    border: 0;
                    border-radius: 16px;
                    box-shadow: 0 10px 25px rgba(0,0,0,.06);
                }

                .chart-box {
                    height: 320px;
                    border: 2px dashed #e5e7eb;
                    border-radius: 12px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    background: #fff;
                }

                .chart-note {
                    color: #94a3b8;
                    font-size: .95rem;
                }

                .metric-card {
                    border: 0;
                    border-radius: 14px;
                    box-shadow: 0 8px 20px rgba(0,0,0,.05);
                }

                .metric-value {
                    font-weight: 700;
                    font-size: 1.6rem;
                    color: #111827;
                }

                .metric-label {
                    color: #6b7280;
                    font-size: .9rem;
                }

                .badge-soft {
                    background: #eef2ff;
                    color: #4f46e5;
                }
            </style>

            <!-- ================= FILTER ================= -->
            <div class="card mb-4">
                <div class="card-body">
                    <form method="get" class="row g-2 align-items-end">
                        <!-- Order / Revenue -->
                        <div class="col-md-3">
                            <label class="form-label mb-1">Type</label>
                            <select name="reportType" class="form-select form-select-sm">
                                <option value="Order" selected="@(rtType == ReportTypeEnum.Order)">Order</option>
                                <option value="Revenue" selected="@(rtType == ReportTypeEnum.Revenue)">Revenue</option>
                            </select>

                        </div>

                        <!-- Weekly / Monthly -->
                        <div class="col-md-3">
                            <label class="form-label mb-1">Mode</label>
                            <select name="reportTime" id="reportTimeSelect" class="form-select form-select-sm">
                                <option value="Weekly" selected="@(rtTime == ReportTimeEnum.Weekly)">Weekly (by day)</option>
                                <option value="Monthly" selected="@(rtTime == ReportTimeEnum.Monthly)">Monthly (by week)</option>
                            </select>

                        </div>

                        <!-- Month -->
                        <div class="col-md-2">
                            <label class="form-label mb-1">Month</label>
                            <input type="number" name="month" class="form-control form-control-sm"
                                   value="@currentMonth" min="1" max="12" />
                        </div>

                        <!-- Week -->
                        <div class="col-md-2" id="week-filter">
                            <label class="form-label mb-1">Week</label>
                            <select name="week" class="form-select form-select-sm">
                                <option value="1" selected="@(currentWeek == 1)">Week 1</option>
                                <option value="2" selected="@(currentWeek == 2)">Week 2</option>
                                <option value="3" selected="@(currentWeek == 3)">Week 3</option>
                                <option value="4" selected="@(currentWeek == 4)">Week 4</option>
                                <option value="5" selected="@(currentWeek == 5)">Week 5</option>
                            </select>

                        </div>

                        <div class="col-md-2">
                            <button type="submit" class="btn btn-sm btn-primary w-100">Apply</button>
                        </div>
                    </form>
                </div>
            </div>
            <!-- =============== END FILTER =============== -->

            <!-- Header -->
            <div class="text-center mb-4">
                <h3 class="fw-bold mb-2">Order / Revenue Report</h3>
                <div class="badge badge-soft rounded-pill px-3 py-2">
                    @if (dataList.Any())
                    {
                        @:From @dataList.Min(x => x.Date).ToString("dd/MM/yyyy") to @dataList.Max(x => x.Date).ToString("dd/MM/yyyy")
                    }
                    else
                    {
                        @:No data
                    }
                </div>
            </div>

            <!-- Charts row -->
            <div class="row g-4 align-items-start">
                <!-- Line chart -->
                <div class="col-lg-7">
                    <div class="card report-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0 text-muted">Timeline</h6>
                                <span class="fw-semibold">(@dataList.Count() points)</span>
                            </div>
                            <div id="lineChart" class="chart-box">
                                <span class="chart-note"></span>
                            </div>
                            <div class="d-flex justify-content-between mt-2 text-muted small">
                                <span>@(labels.FirstOrDefault() ?? "-")</span>
                                <span>@(labels.LastOrDefault() ?? "-")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Donut chart (placeholder) -->
                <div class="col-lg-5">
                    <div class="card report-card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0 text-muted">Sessions</h6>
                                <span class="fw-semibold">4,414</span>
                            </div>
                            <div id="donutChart" class="chart-box">
                                <span class="chart-note">Thêm chart donut vào #donutChart (tạm thời demo)</span>
                            </div>
                            <div class="row row-cols-2 g-2 small text-muted mt-3">
                                <div class="col">• Organic Search <span class="text-dark fw-semibold">697</span></div>
                                <div class="col">• Direct <span class="text-dark fw-semibold">601</span></div>
                                <div class="col">• Others <span class="text-dark fw-semibold">667</span></div>
                                <div class="col">• Referral <span class="text-dark fw-semibold">559</span></div>
                                <div class="col">• Social <span class="text-dark fw-semibold">640</span></div>
                                <div class="col">• Paid Search <span class="text-dark fw-semibold">550</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Metrics -->
            <div class="row g-4 mt-1 mt-lg-4">
                <div class="col-md-4">
                    <div class="card metric-card">
                        <div class="card-body text-center py-4">
                            <div class="metric-label mb-1">Total Points</div>
                            <div class="metric-value">@dataList.Count()</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card metric-card">
                        <div class="card-body text-center py-4">
                            <div class="metric-label mb-1">Max Value</div>
                            <div class="metric-value">@maxValue</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card metric-card">
                        <div class="card-body text-center py-4">
                            <div class="metric-label mb-1">Total Sum</div>
                            <div class="metric-value">@totalSum</div>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    const timeSelect = document.getElementById('reportTimeSelect');
                    const weekFilter = document.getElementById('week-filter');

                    function toggleWeek() {
                        if (timeSelect.value === 'Weekly') {
                            weekFilter.style.display = '';
                        } else {
                            weekFilter.style.display = 'none';
                        }
                    }

                    timeSelect.addEventListener('change', toggleWeek);
                    toggleWeek();
                });
            </script>

            <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
            <script>
                var categories = @Html.Raw(labelsJson);
                var seriesData = @Html.Raw(valuesJson);

                var options = {
                    chart: {
                        type: 'line',
                        height: 320
                    },
                    series: [{
                        name: 'Value',
                        data: seriesData
                    }],
                    xaxis: {
                        categories: categories
                    },
                    stroke: {
                        curve: 'smooth'
                    },
                    dataLabels: {
                        enabled: true
                    },
                    yaxis: {
                        labels: {
                            formatter: function (value) {
                                return value;
                            }
                        }
                    }
                };

                var chart = new ApexCharts(document.querySelector("#lineChart"), options);
                chart.render();
            </script>
        </div>
    </div>
</div>
