@model Presentation.ViewModel.ReportVM
@{
    ViewData["Title"] = "Quản lý báo cáo";
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <link rel="shortcut icon" type="image/png" href="/Modernize-1.0.0/Modernize-1.0.0/src/assets/images/logos/favicon.png" />
    <link rel="stylesheet" href="/Modernize-1.0.0/Modernize-1.0.0/src/assets/css/styles.min.css" />
</head>
<body>
    <div class="page-wrapper" id="main-wrapper" data-layout="vertical" data-navbarbg="skin6" data-sidebartype="full" data-sidebar-position="fixed" data-header-position="fixed">
        @await Html.PartialAsync("_sidebar")
        <div class="body-wrapper">
            <header class="app-header">
                <nav class="navbar navbar-expand-lg navbar-light">
                    <ul class="navbar-nav">
                        <li class="nav-item d-block d-xl-none">
                            <a class="nav-link sidebartoggler nav-icon-hover" id="headerCollapse" href="javascript:void(0)">
                                <i class="ti ti-menu-2"></i>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-icon-hover" href="javascript:void(0)">
                                <i class="ti ti-bell-ringing"></i>
                                <div class="notification bg-primary rounded-circle"></div>
                            </a>
                        </li>
                    </ul>
                    <div class="navbar-collapse justify-content-end px-0" id="navbarNav">
                        <ul class="navbar-nav flex-row ms-auto align-items-center justify-content-end">
                            <li class="nav-item dropdown">
                                <a class="nav-link nav-icon-hover" href="javascript:void(0)" id="drop2" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="../assets/images/profile/user-1.jpg" alt="" width="35" height="35" class="rounded-circle">
                                </a>
                                <div class="dropdown-menu dropdown-menu-end dropdown-menu-animate-up" aria-labelledby="drop2">
                                    <div class="message-body">
                                        <a href="javascript:void(0)" class="d-flex align-items-center gap-2 dropdown-item">
                                            <i class="ti ti-user fs-6"></i>
                                            <p class="mb-0 fs-3">My Profile</p>
                                        </a>
                                        <a href="javascript:void(0)" class="d-flex align-items-center gap-2 dropdown-item">
                                            <i class="ti ti-mail fs-6"></i>
                                            <p class="mb-0 fs-3">My Account</p>
                                        </a>
                                        <a href="javascript:void(0)" class="d-flex align-items-center gap-2 dropdown-item">
                                            <i class="ti ti-list-check fs-6"></i>
                                            <p class="mb-0 fs-3">My Task</p>
                                        </a>
                                        <a href="./authentication-login.html" class="btn btn-outline-primary mx-3 mt-2 d-block">Logout</a>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                </nav>
            </header>

            <div class="container-fluid py-3">
                <h3 class="mb-3">Quản lý báo cáo</h3>

                <!-- KPI Cards -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 text-center p-3">
                            <div class="fs-4 fw-bold text-primary">@Model.TotalRevenue.ToString("N0") ₫</div>
                            <div class="text-muted small">Tổng doanh thu</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 text-center p-3">
                            <div class="fs-4 fw-bold text-success">@Model.TotalOrders</div>
                            <div class="text-muted small">Tổng đơn hàng</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 text-center p-3">
                            <div class="fs-4 fw-bold text-warning">@Model.AverageOrderValue.ToString("N0") ₫</div>
                            <div class="text-muted small">Giá trị đơn hàng TB</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card shadow-sm border-0 text-center p-3">
                            <div class="fs-4 fw-bold text-info">@Model.ReturnRate.ToString("P1")</div>
                            <div class="text-muted small">Tỷ lệ hoàn/huỷ</div>
                        </div>
                    </div>
                </div>

                <!-- Form lọc & sắp xếp -->
                <form asp-action="Index" method="get" class="row g-2 mb-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Khoảng thời gian</label>
                        <div class="d-flex gap-2">
                            <input type="date" name="From" class="form-control" value="@Model.From?.ToString("yyyy-MM-dd")" />
                            <input type="date" name="To" class="form-control" value="@Model.To?.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Kênh bán</label>
                        <select name="Channel" class="form-select">
                            <option value="">Tất cả</option>
                            <option value="Online" selected="@(Model.Channel=="Online")">Online</option>
                            <option value="Offline" selected="@(Model.Channel=="Offline")">Offline</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Nhóm sản phẩm</label>
                        <select name="CategoryId" class="form-select">
                            <option value="">Tất cả</option>
                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.Id" selected="@(Model.CategoryId==c.Id)">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 d-grid d-md-flex justify-content-md-end gap-2">
                        <button type="submit" class="btn btn-outline-primary">Áp dụng</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                    </div>
                </form>

                <!-- Charts Row -->
                <div class="row g-3">
                    <div class="col-lg-6">
                        <div class="card h-100 shadow-sm">
                            <div class="card-header bg-light d-flex align-items-center justify-content-between">
                                <h5 class="mb-0">Báo cáo doanh thu</h5>
                                <small class="text-muted">(đang để trống chart)</small>
                            </div>
                            <div class="card-body">
                                <!-- Placeholder cho thư viện chart doanh thu -->
                                <div id="revenueChart" style="width:100%;height:360px;display:flex;align-items:center;justify-content:center;border:1px dashed #e5e7eb;border-radius:.5rem;">
                                    <span class="text-muted">Thêm chart của bạn vào #revenueChart</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="card h-100 shadow-sm">
                            <div class="card-header bg-light d-flex align-items-center justify-content-between">
                                <h5 class="mb-0">Báo cáo đơn hàng</h5>
                                <small class="text-muted">(đang để trống chart)</small>
                            </div>
                            <div class="card-body">
                                <!-- Placeholder cho thư viện chart đơn hàng -->
                                <div id="ordersChart" style="width:100%;height:360px;display:flex;align-items:center;justify-content:center;border:1px dashed #e5e7eb;border-radius:.5rem;">
                                    <span class="text-muted">Thêm chart của bạn vào #ordersChart</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bảng tóm tắt -->
                <div class="row g-3 mt-3">
                    <div class="col-12">
                        <div class="card shadow-sm">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Tóm tắt theo ngày</h5>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0 align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Ngày</th>
                                                <th class="text-end">Doanh thu (₫)</th>
                                                <th class="text-end">Số đơn</th>
                                                <th class="text-end">Giá trị TB (₫)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.DailySummary == null || !Model.DailySummary.Any())
                                            {
                                                <tr>
                                                    <td colspan="4" class="text-center py-4 text-muted">Không có dữ liệu.</td>
                                                </tr>
                                            }
                                            else
                                            {
                                                foreach (var d in Model.DailySummary)
                                                {
                                                    <tr>
                                                        <td>@d.Date.ToString("dd/MM/yyyy")</td>
                                                        <td class="text-end">@d.Revenue.ToString("N0")</td>
                                                        <td class="text-end">@d.Orders</td>
                                                        <td class="text-end">@d.AOV.ToString("N0")</td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Scripts mặc định, KHÔNG thêm thư viện chart ở đây -->
    <script src="/Modernize-1.0.0/Modernize-1.0.0/src/assets/libs/jquery/dist/jquery.min.js"></script>
    <script src="/Modernize-1.0.0/Modernize-1.0.0/src/assets/libs/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/Modernize-1.0.0/Modernize-1.0.0/src/assets/js/sidebarmenu.js"></script>
    <script src="/Modernize-1.0.0/Modernize-1.0.0/src/assets/js/app.min.js"></script>
    <script src="/Modernize-1.0.0/Modernize-1.0.0/src/assets/libs/simplebar/dist/simplebar.js"></script>

    <!-- Vị trí bạn có thể thêm code khởi tạo chart sau này -->
    <script>
        // Ví dụ: sau khi thêm thư viện, khởi tạo biểu đồ tại đây
        // const elRevenue = document.getElementById('revenueChart');
        // const elOrders = document.getElementById('ordersChart');
        // new Chart(elRevenue.getContext('2d'), {...});
        // new Chart(elOrders.getContext('2d'), {...});
    </script>
</body>
</html>