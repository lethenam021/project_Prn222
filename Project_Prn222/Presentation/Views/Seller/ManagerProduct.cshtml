<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Quản lý Product</title>
    <link href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css" rel="stylesheet">
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <div class="app">
        <!-- SIDEBAR riêng cho product.html -->
        <aside class="sidebar">
            <div class="logo">
                <i class="ri-shopping-bag-2-line"></i> <span>Product Admin</span>
            </div>
            <nav class="nav">
                <a href="store.html"><i class="ri-store-3-line"></i> Store</a>
                <a class="active" href="product.html"><i class="ri-shopping-bag-3-line"></i> Product <span class="badge" id="badge-prod">0</span></a>
                <a href="#"><i class="ri-settings-3-line"></i> Cài đặt</a>
            </nav>
        </aside>

        <main>
            <div class="topbar">
                <div class="row">
                    <div class="search">
                        <i class="ri-search-line"></i>
                        <input id="q" type="text" placeholder="Tìm sản phẩm theo tên, mô tả...">
                    </div>
                    <select id="filterCat" style="width:200px;">
                        <option value="">Tất cả danh mục</option>
                        <option value="1">Điện tử</option>
                        <option value="2">Gia dụng</option>
                        <option value="3">Sách</option>
                        <option value="4">Thời trang</option>
                    </select>
                    <select id="filterSeller" style="width:200px;">
                        <option value="">Tất cả seller</option>
                        <option value="10">Seller #10</option>
                        <option value="11">Seller #11</option>
                        <option value="12">Seller #12</option>
                    </select>
                </div>
                <div class="row">
                    <button class="btn" id="btn-add"><i class="ri-add-line"></i> Thêm sản phẩm</button>
                </div>
            </div>

            <div class="toolbar">
                <div class="row">
                    <button class="btn secondary" id="mode-grid"><i class="ri-layout-grid-line"></i> Card</button>
                    <button class="btn secondary" id="mode-list"><i class="ri-list-unordered"></i> List</button>
                </div>
                <div class="row right">
                    <select id="sortBy">
                        <option value="title-asc">Tên A→Z</option>
                        <option value="title-desc">Tên Z→A</option>
                        <option value="price-asc">Giá tăng dần</option>
                        <option value="price-desc">Giá giảm dần</option>
                        <option value="auctionEndTime-asc">Kết thúc sớm→muộn</option>
                        <option value="auctionEndTime-desc">Kết thúc muộn→sớm</option>
                    </select>
                </div>
            </div>

            <div class="content">
                <div class="kpis">
                    <div class="kpi">
                        <div class="muted">Tổng sản phẩm</div>
                        <div id="kpi-total" style="font-size:28px; font-weight:700;"></div>
                    </div>
                    <div class="kpi">
                        <div class="muted">Hình thức đấu giá</div>
                        <div id="kpi-auction" style="font-size:28px; font-weight:700;"></div>
                    </div>
                    <div class="kpi">
                        <div class="muted">Giá trung bình</div>
                        <div id="kpi-avg" style="font-size:28px; font-weight:700;"></div>
                    </div>
                    <div class="kpi">
                        <div class="muted">Danh mục</div>
                        <div id="kpi-cats" style="font-size:28px; font-weight:700;"></div>
                    </div>
                </div>

                <div id="prod-grid" class="grid"></div>
                <table id="prod-table" class="table hidden">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Tên</th>
                            <th>Mô tả</th>
                            <th>Giá</th>
                            <th>Danh mục</th>
                            <th>Seller</th>
                            <th>Đấu giá</th>
                            <th>Kết thúc</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <div class="footer">© 2025 Product Admin</div>
        </main>
    </div>

    <!-- Dialog thêm/sửa sản phẩm -->
    <div class="dialog-backdrop" id="dlg-backdrop"></div>
    <div class="dialog" id="dlg-prod">
        <div class="row" style="justify-content: space-between;">
            <strong id="dlg-title">Thêm sản phẩm</strong>
            <button class="btn ghost" id="dlg-close"><i class="ri-close-line"></i>Đóng</button>
        </div>
        <div class="form-grid" style="margin-top:12px;">
            <div class="form-row"><label>Tiêu đề</label><input id="f-title" type="text"></div>
            <div class="form-row"><label>Giá</label><input id="f-price" type="number" min="0" step="0.01"></div>
            <div class="form-row" style="grid-column:1/-1;"><label>Mô tả</label><textarea id="f-description" rows="3"></textarea></div>
            <div class="form-row">
                <label>Danh mục</label>
                <select id="f-categoryId">
                    <option value="1">Điện tử</option>
                    <option value="2">Gia dụng</option>
                    <option value="3">Sách</option>
                    <option value="4">Thời trang</option>
                </select>
            </div>
            <div class="form-row">
                <label>Seller</label>
                <select id="f-sellerId">
                    <option value="10">#10</option>
                    <option value="11">#11</option>
                    <option value="12">#12</option>
                </select>
            </div>
            <div class="form-row">
                <label>Đấu giá?</label>
                <select id="f-isAuction">
                    <option value="false">Không</option>
                    <option value="true">Có</option>
                </select>
            </div>
            <div class="form-row"><label>Hạn đấu giá</label><input id="f-auctionEndTime" type="datetime-local"></div>
            <div class="form-row" style="grid-column:1/-1;"><label>Ảnh (URL, cách nhau bằng dấu phẩy)</label><input id="f-images" type="text"></div>
        </div>
        <div class="row" style="margin-top:12px; justify-content:flex-end;">
            <button class="btn secondary" id="dlg-cancel">Hủy</button>
            <button class="btn success" id="dlg-save"><i class="ri-save-3-line"></i>Lưu</button>
        </div>
    </div>

    <script>
        // "Database" cứng cho Product
        let products = [
          { id: 101, title: "Tai nghe Bluetooth X1", description: "Chống ồn, pin 30h", price: 59.9, images: ["https://images.unsplash.com/photo-1518441982123-cd39fb0f0a43?q=80&w=1200&auto=format&fit=crop"], categoryId: 1, sellerId: 10, isAuction: false, auctionEndTime: "" },
          { id: 102, title: "Nồi chiên không dầu 5L", description: "Tiết kiệm dầu 85%", price: 89.0, images: ["https://images.unsplash.com/photo-1623428454614-8b8c629ab2ed?q=80&w=1200&auto=format&fit=crop"], categoryId: 2, sellerId: 11, isAuction: false, auctionEndTime: "" },
          { id: 103, title: "Bộ sách kỹ năng", description: "3 cuốn best-seller", price: 24.5, images: ["https://images.unsplash.com/photo-1495446815901-a7297e633e8d?q=80&w=1200&auto=format&fit=crop"], categoryId: 3, sellerId: 12, isAuction: true, auctionEndTime: "2025-12-31T23:59" },
          { id: 104, title: "Áo sơ mi nam Classic", description: "Cotton thoáng mát", price: 32.0, images: ["https://images.unsplash.com/photo-1516826957135-700dedea698c?q=80&w=1200&auto=format&fit=crop"], categoryId: 4, sellerId: 10, isAuction: false, auctionEndTime: "" },
        ];

        const categories = {
          1: "Điện tử",
          2: "Gia dụng",
          3: "Sách",
          4: "Thời trang"
        };

        let viewMode = "grid";
        let editingId = null;

        // Elements
        const gridEl = document.getElementById("prod-grid");
        const tableEl = document.getElementById("prod-table");
        const tbodyEl = tableEl.querySelector("tbody");
        const qEl = document.getElementById("q");
        const sortEl = document.getElementById("sortBy");
        const catEl = document.getElementById("filterCat");
        const sellerEl = document.getElementById("filterSeller");
        const badgeProd = document.getElementById("badge-prod");

        function fmtPrice(n){ return Intl.NumberFormat('vi-VN', {style:'currency', currency:'VND'}).format(n*1000); }
        function fmtDate(s){ if(!s) return "-"; const d = new Date(s); return d.toLocaleString("vi-VN"); }

        // KPI
        function renderKPI() {
          const total = products.length;
          const auction = products.filter(p => p.isAuction).length;
          const avg = products.reduce((a,b)=>a+b.price,0) / (products.length || 1);
          const cats = new Set(products.map(p=>p.categoryId)).size;
          document.getElementById("kpi-total").textContent = total;
          document.getElementById("kpi-auction").textContent = auction;
          document.getElementById("kpi-avg").textContent = fmtPrice(avg);
          document.getElementById("kpi-cats").textContent = cats;
          badgeProd.textContent = total;
        }

        function applyFilterSort(data) {
          const q = qEl.value.trim().toLowerCase();
          let out = data.filter(p =>
            p.title.toLowerCase().includes(q) ||
            p.description.toLowerCase().includes(q)
          );
          if (catEl.value) out = out.filter(p => String(p.categoryId) === catEl.value);
          if (sellerEl.value) out = out.filter(p => String(p.sellerId) === sellerEl.value);

          const [field, dir] = sortEl.value.split("-");
          out.sort((a,b) => {
            const get = (x) => field === "price" ? x.price : (field === "auctionEndTime" ? (x.auctionEndTime||"") : x.title.toLowerCase());
            if (get(a) < get(b)) return dir === "asc" ? -1 : 1;
            if (get(a) > get(b)) return dir === "asc" ? 1 : -1;
            return 0;
          });
          return out;
        }

        function render() {
          renderKPI();
          const data = applyFilterSort(products);
          gridEl.innerHTML = "";
          tbodyEl.innerHTML = "";

          if (viewMode === "grid") {
            gridEl.classList.remove("hidden");
            tableEl.classList.add("hidden");
            data.forEach(p => {
              const card = document.createElement("div");
              card.className = "card";
              card.style.gridColumn = "span 3";
              card.innerHTML = `
                <div class="cover" style="background-image:url('${(p.images[0]||"https://placehold.co/800x600?text=No+Image")}')"></div>
                <div class="row" style="justify-content: space-between;">
                  <div>
                    <div style="font-weight:700">${p.title}</div>
                    <div class="muted">${categories[p.categoryId] || "?"} • Seller #${p.sellerId}</div>
                  </div>
                  <div style="font-weight:700">${fmtPrice(p.price)}</div>
                </div>
                <div class="muted" style="margin-top:8px">${p.description || ""}</div>
                <div class="row" style="margin-top:10px; justify-content: space-between;">
                  <div class="muted">${p.isAuction ? '<i class="ri-auction-line"></i> ' + fmtDate(p.auctionEndTime) : 'Bán ngay'}</div>
                  <div class="row">
                    <button class="btn ghost" data-edit="${p.id}"><i class="ri-edit-2-line"></i></button>
                    <button class="btn ghost" data-del="${p.id}"><i class="ri-delete-bin-6-line"></i></button>
                  </div>
                </div>
              `;
              gridEl.appendChild(card);
            });
          } else {
            gridEl.classList.add("hidden");
            tableEl.classList.remove("hidden");
            data.forEach((p, idx) => {
              const tr = document.createElement("tr");
              tr.innerHTML = `
                <td>${idx+1}</td>
                <td>${p.title}</td>
                <td class="muted">${p.description || ""}</td>
                <td>${fmtPrice(p.price)}</td>
                <td>${categories[p.categoryId] || ""}</td>
                <td>#${p.sellerId}</td>
                <td>${p.isAuction ? '<i class="ri-auction-line"></i>' : '-'}</td>
                <td>${fmtDate(p.auctionEndTime)}</td>
                <td class="row" style="justify-content:flex-end;">
                  <button class="btn ghost" data-edit="${p.id}"><i class="ri-edit-2-line"></i>Sửa</button>
                  <button class="btn ghost" data-del="${p.id}"><i class="ri-delete-bin-6-line"></i>Xóa</button>
                </td>
              `;
              tbodyEl.appendChild(tr);
            });
          }
        }

        document.getElementById("mode-grid").onclick = () => { viewMode = "grid"; render(); };
        document.getElementById("mode-list").onclick = () => { viewMode = "list"; render(); };
        [qEl, sortEl, catEl, sellerEl].forEach(el => el.addEventListener("input", render));
        sortEl.onchange = render;

        // Dialog logic
        const dlg = document.getElementById("dlg-prod");
        const backdrop = document.getElementById("dlg-backdrop");
        function openDlg(title, prod) {
          document.getElementById("dlg-title").textContent = title;
          dlg.classList.add("open"); backdrop.classList.add("open");
          document.getElementById("f-title").value = prod?.title || "";
          document.getElementById("f-price").value = prod?.price ?? "";
          document.getElementById("f-description").value = prod?.description || "";
          document.getElementById("f-categoryId").value = prod?.categoryId ?? "1";
          document.getElementById("f-sellerId").value = prod?.sellerId ?? "10";
          document.getElementById("f-isAuction").value = String(!!prod?.isAuction);
          document.getElementById("f-auctionEndTime").value = prod?.auctionEndTime || "";
          document.getElementById("f-images").value = (prod?.images || []).join(", ");
        }
        function closeDlg(){ dlg.classList.remove("open"); backdrop.classList.remove("open"); editingId = null; }
        document.getElementById("dlg-close").onclick = closeDlg;
        document.getElementById("dlg-cancel").onclick = closeDlg;
        document.getElementById("btn-add").onclick = () => { editingId = null; openDlg("Thêm sản phẩm"); };

        document.addEventListener("click", (e) => {
          const editId = e.target.closest?.("button[data-edit]")?.dataset?.edit;
          const delId = e.target.closest?.("button[data-del]")?.dataset?.del;
          if (editId) {
            const p = products.find(x => x.id == editId);
            editingId = p.id;
            openDlg("Sửa sản phẩm", p);
          }
          if (delId) {
            const idx = products.findIndex(x => x.id == delId);
            if (idx >= 0 && confirm("Xóa sản phẩm này?")) {
              products.splice(idx,1);
              render();
            }
          }
        });

        document.getElementById("dlg-save").onclick = () => {
          const payload = {
            title: document.getElementById("f-title").value.trim(),
            price: Number(document.getElementById("f-price").value || 0),
            description: document.getElementById("f-description").value.trim(),
            categoryId: Number(document.getElementById("f-categoryId").value),
            sellerId: Number(document.getElementById("f-sellerId").value),
            isAuction: document.getElementById("f-isAuction").value === "true",
            auctionEndTime: document.getElementById("f-auctionEndTime").value,
            images: document.getElementById("f-images").value.split(",").map(s=>s.trim()).filter(Boolean),
          };
          if (!payload.title) { alert("Nhập tiêu đề"); return; }
          if (payload.isAuction && !payload.auctionEndTime) { alert("Chọn hạn đấu giá"); return; }

          if (editingId) {
            const i = products.findIndex(p => p.id === editingId);
            products[i] = { ...products[i], ...payload };
          } else {
            const id = Math.max(0, ...products.map(p => p.id)) + 1;
            products.push({ id, ...payload });
          }
          closeDlg();
          render();
        };

        // init
        render();
    </script>
</body>
</html>
