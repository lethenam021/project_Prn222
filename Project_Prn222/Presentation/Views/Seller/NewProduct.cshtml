     File: product-new.html
     ============================ -->
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đăng bán sản phẩm • CloneEbay</title>
    <link rel="stylesheet" href="styles.css" />
</head>
<body>
    <header class="appbar">
        <div class="appbar-inner container">
            <div class="logo" aria-hidden="true"></div>
            <div class="app-title">CloneEbay • New Product</div>
        </div>
    </header>

    <main class="container">
        <section class="header">
            <h1>Đăng bán sản phẩm</h1>
            <p>Tạo listing mới. Dữ liệu tương ứng bảng <code>Product</code>.</p>
        </section>

        <form class="panel" action="/api/products" method="post" enctype="multipart/form-data">
            <h2 class="section-title">Thông tin cơ bản</h2>
            <div class="grid cols-2">
                <div class="field">
                    <label class="label" for="title">Tiêu đề</label>
                    <input class="input" type="text" id="title" name="title" placeholder="VD: Tai nghe Bluetooth ANC" maxlength="160" required />
                    <div class="hint">Ánh xạ tới <code>Product.title</code></div>
                </div>
                <div class="field">
                    <label class="label" for="price">Giá (VND)</label>
                    <input class="input" type="number" step="0.01" min="0" id="price" name="price" placeholder="Nhập giá" required />
                    <div class="hint">Ánh xạ tới <code>Product.price</code></div>
                </div>
            </div>

            <div class="grid">
                <div class="field">
                    <label class="label" for="descriptionP">Mô tả sản phẩm</label>
                    <textarea class="textarea" id="descriptionP" name="description" placeholder="Mô tả chi tiết thông số, chất liệu, bảo hành…" maxlength="5000" required></textarea>
                    <div class="hint">Ánh xạ tới <code>Product.description</code></div>
                </div>
            </div>

            <hr class="sep" />

            <h2 class="section-title">Phân loại & quyền sở hữu</h2>
            <div class="grid cols-3">
                <div class="field">
                    <label class="label" for="categoryId">Category ID</label>
                    <input class="input" type="number" id="categoryId" name="categoryId" placeholder="Nhập categoryId" required />
                    <div class="hint">Ánh xạ tới <code>Product.categoryId</code></div>
                </div>
                <div class="field">
                    <label class="label" for="sellerIdP">Seller ID</label>
                    <input class="input" type="number" id="sellerIdP" name="sellerId" placeholder="Nhập sellerId" required />
                    <div class="hint">Ánh xạ tới <code>Product.sellerId</code></div>
                </div>
                <div class="field">
                    <label class="label" for="isAuction">Bán đấu giá?</label>
                    <select class="select" id="isAuction" name="isAuction" required>
                        <option value="false" selected>Không</option>
                        <option value="true">Có</option>
                    </select>
                    <div class="hint">Ánh xạ tới <code>Product.isAuction</code></div>
                </div>
            </div>

            <div class="grid cols-2">
                <div class="field">
                    <label class="label" for="auctionEndTime">Thời điểm kết thúc đấu giá</label>
                    <input class="input" type="datetime-local" id="auctionEndTime" name="auctionEndTime" />
                    <div class="hint">Bắt buộc nếu chọn đấu giá. Ánh xạ tới <code>Product.auctionEndTime</code></div>
                </div>
            </div>

            <hr class="sep" />

            <h2 class="section-title">Hình ảnh sản phẩm</h2>
            <div class="grid cols-2">
                <div class="field file">
                    <label class="label" for="images">Tải ảnh (có thể chọn nhiều)</label>
                    <input class="input" type="file" id="images" name="images" accept="image/*" multiple />
                    <div class="hint">Ánh xạ tới <code>Product.images</code> (lưu ý cấu trúc lưu trữ của bạn: mảng URL, JSON, bảng phụ …)</div>
                </div>
                <div class="field">
                    <label class="label" for="coverUrl">Ảnh bìa (URL tùy chọn)</label>
                    <input class="input" type="url" id="coverUrl" name="coverUrl" placeholder="https://cdn.yourdomain.com/products/cover.jpg" />
                    <div class="hint">Nếu dùng URL sẵn có từ CDN</div>
                </div>
            </div>

            <div class="actions" style="margin-top: 18px;">
                <button class="btn" type="submit">Đăng sản phẩm</button>
                <button class="btn secondary" type="reset">Làm lại</button>
                <a class="btn danger" href="/dashboard/products">Hủy</a>
            </div>

            <hr class="sep" />
            <div class="helper-card">
                <p>Gợi ý: Ảnh tối ưu 1200×1200px, nén &lt; 300KB/ảnh, đặt tên file không dấu, không khoảng trắng.</p>
            </div>
        </form>

        <p class="footer-note">© 2025 CloneEbay – Product module</p>
    </main>
</body>
</html>
